DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/syntiqhq?schema=public"

# Used to build public links like review URLs. No trailing slash.
PUBLIC_SITE_URL="https://syntiqhq.com"

# Contact form emails (the inbox notification and the confirmation to the sender) go through Resend.
# The from address must be on a domain verified in Resend. Replies to it go to CONTACT_INBOX_EMAIL.
RESEND_API_KEY="re_..."
CONTACT_FROM_EMAIL="SyntiqHQ <no-reply@syntiqhq.com>"
CONTACT_INBOX_EMAIL="contact@syntiqhq.com"

# Used once by `npm run db:seed` to create the first admin user.
SEED_ADMIN_EMAIL="francis@syntiqhq.com"
SEED_ADMIN_PASSWORD="change-me-to-a-long-password"
SEED_ADMIN_NAME="Francis"
